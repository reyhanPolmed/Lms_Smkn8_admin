' ============================================================
' 14. MANAJEMEN KELAS - Alokasi Modul ke Kelas
' ============================================================
@startuml SD_14_Alokasi_Modul
title SD-14: Alokasi Modul ke Kelas

skinparam sequence {
    ArrowColor #2563EB
    ParticipantBorderColor #3B82F6
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #93C5FD
}
skinparam actorStyle awesome

actor Admin

box "Frontend" #F0F9FF
    participant "Form Alokasi Modul" as View
end box

box "Backend (Filament)" #FFF7ED
    participant "ClassResource" as Ctrl
end box

box "Database" #F0FDF4
    database "DB" as DB
end box

Admin -> View : Pilih kelas & pilih modul/mapel yang akan dialokasikan
View -> Ctrl : POST /admin/classes/{id}/modules (data alokasi)
Ctrl -> DB : Cek apakah modul sudah dialokasikan ke kelas ini

alt [Belum Dialokasikan]
    Ctrl -> DB : INSERT ke tabel pivot (class_module)
    DB --> Ctrl : Sukses tersimpan
    Ctrl --> View : Notifikasi "Modul berhasil dialokasikan"
    View --> Admin : Refresh daftar modul di kelas
else [Sudah Dialokasikan]
    DB --> Ctrl : Data duplikat ditemukan
    Ctrl --> View : Kembalikan pesan error
    View --> Admin : Tampilkan "Modul sudah ada di kelas ini"
end

@enduml