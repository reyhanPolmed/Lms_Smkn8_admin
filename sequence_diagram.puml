' ============================================================
' SEQUENCE DIAGRAMS - LMS SMKN 8 MEDAN (Admin Module)
' Total: 14 Diagram
' ============================================================

' ============================================================
' 1. LOGIN (Autentikasi)
' ============================================================
@startuml SD_01_Login
title SD-01: Login Admin

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #1E40AF
    ParticipantBorderColor #3B82F6
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #93C5FD
    NoteBackgroundColor #DBEAFE
    NoteBorderColor #3B82F6
}
skinparam actorStyle awesome

actor Admin

box "Frontend" #F0F9FF
    participant "Halaman Login" as View
end box

box "Backend (Filament)" #FFF7ED
    participant "Auth Controller" as Auth
end box

box "Database" #F0FDF4
    database "DB" as DB
end box

Admin -> View : Memasukkan email & password
View -> Auth : POST /admin/login
Auth -> DB : Query: cari user berdasarkan email
DB --> Auth : Kembalikan data user

alt [Kredensial Valid]
    Auth --> View : Login berhasil
    View --> Admin : Redirect ke Dashboard
else [Kredensial Tidak Valid]
    Auth --> View : Kembalikan pesan error
    View --> Admin : Tampilkan "Email atau password salah"
end

@enduml


' ============================================================
' 2. DASHBOARD
' ============================================================
@startuml SD_02_Dashboard
title SD-02: Menampilkan Dashboard

skinparam sequence {
    ArrowColor #2563EB
    ParticipantBorderColor #3B82F6
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #93C5FD
}
skinparam actorStyle awesome

actor Admin

box "Frontend" #F0F9FF
    participant "Halaman Dashboard" as View
end box

box "Backend (Filament)" #FFF7ED
    participant "Dashboard Controller" as DC
    participant "Widget Service" as WS
end box

box "Database" #F0FDF4
    database "DB" as DB
end box

Admin -> View : Akses /admin/dashboard
View -> DC : GET /admin/dashboard
DC -> WS : Minta data statistik
WS -> DB : Query jumlah Admin, Guru, Siswa, Jurusan
DB --> WS : Kembalikan agregat data
WS --> DC : Kumpulkan data widget
DC --> View : Render widget & grafik statistik
View --> Admin : Tampilkan Dashboard (statistik & chart)

@enduml


' ============================================================
' 3. MANAJEMEN ADMIN
' ============================================================
@startuml SD_03_Manajemen_Admin
title SD-03: Tambah Admin Baru

skinparam sequence {
    ArrowColor #2563EB
    ParticipantBorderColor #3B82F6
    ParticipantBackgroundColor #EFF6FF
    LifeLineBorderColor #93C5FD
}
skinparam actorStyle awesome

actor Admin

box "Frontend" #F0F9FF
    participant "Form Tambah Admin" as View
end box

box "Backend (Filament)" #FFF7ED
    participant "AdminResource" as Ctrl
end box

box "Database" #F0FDF4
    database "DB" as DB
end box

Admin -> View : Isi form (nama, email, password, role)
View -> Ctrl : POST /admin/admins (data form)
Ctrl -> DB : Cek apakah email sudah terdaftar

alt [Email Unik]
    Ctrl -> DB : INSERT ke tabel admins
    DB --> Ctrl : Sukses tersimpan
    Ctrl --> View : Notifikasi "Admin berhasil ditambahkan"
    View --> Admin : Tampilkan pesan sukses & refresh tabel
else [Email Duplikat]
    DB --> Ctrl : Email sudah ada
    Ctrl --> View : Kembalikan error validasi
    View --> Admin : Tampilkan "Email sudah digunakan"
end

@enduml


